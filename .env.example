# Images
# FESS_VERSION and OPENSEARCH_VERSION are the single place to bump the pair.
# FESS_IMAGE / OPENSEARCH_IMAGE override the whole tag and win over the versions
# above them, so leave them commented unless you are pointing at a custom build.
# The Fess image MUST be a -noble variant: it carries imagemagick, poppler and
# unoconv, without which no image/PDF/Office thumbnail is generated at all.
FESS_VERSION=15.8.0
OPENSEARCH_VERSION=3.8.0
# FESS_IMAGE=ghcr.io/codelibs/fess:15.8.0-noble
# OPENSEARCH_IMAGE=ghcr.io/codelibs/fess-opensearch:3.8.0
NGINX_IMAGE=nginx:alpine
ALPINE_IMAGE=alpine:3.21
CLIP_SERVER_IMAGE=docker-multimodalsearch/clip-server:local

# Plugin
# Installed by the Fess image at startup from https://maven.codelibs.org
# (release, or snapshot for a -SNAPSHOT version). Keep the plugin version in step
# with FESS_VERSION. To run a locally built jar instead, leave FESS_PLUGINS EMPTY
# and copy the jar into data/fess/usr/share/fess/app/WEB-INF/plugin/ AFTER running
# bin/setup.sh (which clears old multimodal jars there on every run). An
# explicitly empty value is honoured and does not fall back to the default.
FESS_PLUGINS=fess-webapp-multimodal:15.8.0

# CLIP model (keep MODEL and DIMENSION in lockstep)
# Changing either one requires recreating the index AND re-crawling: the
# dimension is frozen into the mapping when the index is created, and a Fess
# reindex copies documents without recomputing embeddings.
CLIP_MODEL_NAME=xlm-roberta-base-ViT-B-32::laion5b-s13b-b90k
MULTIMODAL_DIMENSION=512
# Embedding server device: cpu | cuda | auto
CLIP_DEVICE=cpu
# Pillow decode cap for untrusted images (oversized / decompression-bomb -> HTTP 400)
CLIP_MAX_IMAGE_PIXELS=64000000
# clip_server runs as a non-root user; bin/setup.sh auto-fills these with the
# host user's UID/GID so the bind-mounted model cache stays writable. Uncomment
# to pin explicit values instead.
# CLIP_UID=1000
# CLIP_GID=1000

# Vector search
# CLIP_MIN_COSINE is the minimum RAW COSINE similarity (0..1) a visual match must
# reach. It is NOT the engine score: Fess converts it with (1 + cos) / 2, so 0.12
# here is what the pre-15.8 CLIP_MIN_SCORE=0.56 meant. The ideal cutoff shifts
# with the model, so re-check it after a model swap.
CLIP_MIN_COSINE=0.12
# kNN retrieval breadth, and the engine used for both the runtime setting and the
# mapping check in bin/init-fess-verify.sh -- the two must agree.
KNN_K=100
KNN_ENGINE=lucene

# Search UI
# Default search results per page (mosaic gallery honors page_size_default)
SEARCH_PAGE_SIZE=20
# Thumbnail sizes. TWO knobs, because Fess has two thumbnail paths:
#   THUMBNAIL_SIZE (WxH) -> the generate-thumbnail script: images, PDF, Office
#   THUMBNAIL_PX   (px)  -> HtmlTagBasedGenerator in Java: HTML pages
# Setting only the first leaves every HTML tile in the gallery at 100x100.
# Changing either one needs bin/setup.sh re-run and the thumbnails regenerated.
THUMBNAIL_SIZE=512x512
THUMBNAIL_PX=512

# Theme
# mosaic 2.0.0 or later is required: 1.0.7 quotes the query when a filter is
# active, which on Fess 15.8 trips the core's query-syntax gate and silently
# drops visual results from every filtered search. fess-themes main follows the
# newest Fess line (mosaic 15.9.x, minFessVersion 15.9, at the time of writing);
# see "Theme" in README.md to pin the 15.8-era build.
THEME_NAME=mosaic
FESS_THEMES_REPO=https://github.com/codelibs/fess-themes.git
FESS_THEMES_REF=main
# FESS_THEMES_DIR=/absolute/path/to/local/fess-themes   # dev: use a local checkout instead of cloning

# Resources
FESS_HEAP=1g
OPENSEARCH_HEAP=1g
OPENSEARCH_HEAP_PROD=3g

# Ops
FESS_ADMIN_PASSWORD=admin
DOMAIN=multimodal.codelibs.org
# How long init-fess-verify waits for the index mapping before failing.
CHUNK_SETUP_MAX_WAIT=300
